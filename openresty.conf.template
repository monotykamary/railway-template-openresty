log_format railway_json escape=json
  '{"timestamp":"$time_iso8601",'
  '"request_id":"$request_id",'
  '"remote_addr":"$remote_addr",'
  '"method":"$request_method",'
  '"path":"$uri",'
  '"status":$status,'
  '"body_bytes_sent":$body_bytes_sent,'
  '"request_time":$request_time,'
  '"user_agent":"$http_user_agent"}';

access_log /dev/stdout railway_json;
error_log /dev/stderr notice;
server_tokens off;

server {
  listen __PORT__;
  server_name _;
  client_max_body_size 1m;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;

  location = /health {
    default_type application/json;
    return 200 '{"status":"ok"}';
  }

  location = / {
    root /app/public;
    try_files /index.html =404;
  }

  location = /openresty.png {
    root /app/public;
  }

  location = /api/hello {
    content_by_lua_file /app/lua/hello.lua;
  }

  location = /api/echo {
    content_by_lua_file /app/lua/echo.lua;
  }

  location / {
    content_by_lua_file /app/lua/not_found.lua;
  }
}
